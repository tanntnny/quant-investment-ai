# Copy this file to .env and fill in the values needed for your run.
# Keep .env out of git.

# Financial data providers
SIMFIN_API_KEY=
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=

# Optional HPC / SLURM module settings used by scripts/slurm/*.sh.
ENABLE_MODULES=0
MODULE_MAMBA=
MODULE_CUDA=
MODULE_GCC=
ENABLE_CONDA=0
CONDA_ENV=

# Optional cache locations for headless plotting/evaluation jobs.
MPLCONFIGDIR=
XDG_CACHE_HOME=
