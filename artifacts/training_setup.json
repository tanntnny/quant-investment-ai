{
  "name": "qai_portfolio_train",
  "mode": {
    "name": "train"
  },
  "data": {
    "_target_": "src.datamodules.qai_portfolio_datamodule.QaiPortfolioDataModule",
    "train_path": "data/preprocessed/train.csv",
    "val_path": "data/preprocessed/val.csv",
    "test_path": "data/preprocessed/test.csv",
    "price_history_path": "data/raw/us-shareprices-daily.csv",
    "sequence_length": 4,
    "feature_columns": null,
    "exclude_columns": [
      "split",
      "window_ready",
      "horizon_target_ready",
      "ticker_history_index"
    ],
    "horizons": [
      1,
      2,
      3,
      4
    ],
    "target_horizon": 4,
    "price_field": "Adj. Close",
    "flat_return_threshold": 0.02,
    "batch_size": 8,
    "num_workers": 0
  },
  "model": {
    "_target_": "src.models.qai_portfolio_attention.QaiPortfolioAttentionModel",
    "input_dim": 42,
    "hidden_dim": 64,
    "num_heads": 4,
    "num_layers": 1,
    "dropout": 0.1,
    "sequence_length": 17
  },
  "loss": {
    "_target_": "src.losses.qai_portfolio_growth.QaiPortfolioGrowthLoss",
    "use_log_growth": true,
    "risk_penalty": 0.0,
    "concentration_penalty": 0.0,
    "eps": 1e-08
  },
  "metrics": {
    "_target_": "src.metrics.qai_portfolio.QaiPortfolioMetrics"
  },
  "optimizer": {
    "_target_": "torch.optim.AdamW",
    "lr": 0.001,
    "weight_decay": 0.0001
  },
  "scheduler": null,
  "trainer": {
    "_target_": "src.trainers.pytorch_trainer.PytorchTrainer",
    "max_epochs": 1,
    "max_steps": 1,
    "precision": 32,
    "accelerator": "auto",
    "gradient_accumulation_steps": 1,
    "val_check_interval": 1.0
  }
}